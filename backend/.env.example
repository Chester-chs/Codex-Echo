# Keep secrets in backend/.env or deployment secret storage, never in VITE_*.
HOST=127.0.0.1
PORT=8787
RADAR_DB_PATH=data/radar.sqlite
POLL_INTERVAL_MS=300000
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MESSAGE_STATE=trial
# Replace field names with fields from YOUR approved WeChat templates.
# WECHAT_TEMPLATES_JSON={"reset":{"id":"YOUR_RESET_TEMPLATE","fields":{"thing1":"title","time2":"time","thing3":"summary"}},"forecast":{"id":"YOUR_FORECAST_TEMPLATE","fields":{"thing1":"title","number2":"probability","time3":"time"}}}
WECHAT_TEMPLATES_JSON={}
# Optional official X API access for long posts that public embeds truncate.
X_BEARER_TOKEN=
FXEMBED_ENABLED=true
ALLOWED_ORIGIN=
TRUST_PROXY=false
