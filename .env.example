# Public configuration only. H5 defaults to /api through the local proxy.
# Preferred WeChat setup: set the CloudBase environment ID. No own server/domain needed.
VITE_WECHAT_CLOUD_ENV=
# Optional self-hosted setup only. H5 preview uses /api.
VITE_RADAR_API_BASE=/api
VITE_RADAR_SOURCE_NAME=AIPlanWatch · X · tokenusage
VITE_RADAR_FEED_URL=
# Keep AppSecret and X API tokens in backend/.env, never in VITE_*.
